{
  "name": "@piensa-it/ui-library",
  "description": "Accessible React components, design tokens, layouts, and motion primitives for maintainable product interfaces.",
  "version": "0.4.2",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Piensa IT",
  "homepage": "https://piensait-ui.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piensa-it/app-ui.git"
  },
  "bugs": {
    "url": "https://github.com/piensa-it/app-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "component-library",
    "accessibility",
    "tailwindcss",
    "ark-ui",
    "storybook"
  ],
  "files": [
    "dist",
    "tailwind-preset.js"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@piensa-it"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:react18": "node scripts/verify-react18.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "peerDependencies": {
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "tailwindcss": "^3.4.17 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@internationalized/date": "^3.12.3",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.32.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.4"
  }
}
